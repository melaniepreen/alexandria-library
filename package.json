{
  "name": "alexandria-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "refresh": "node --env-file=.env scripts/refresh.mjs",
    "worker": "node --env-file=.env scripts/worker.mjs",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "build:local": "ASTRO_TELEMETRY_DISABLED=1 LOCAL_PREVIEW=1 astro build",
    "start:local": "HOST=127.0.0.1 PORT=4330 node .local-build/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.17",
    "astro": "^7.4.4",
    "fast-xml-parser": "^5.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0",
    "zod": "^4.6.7",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}